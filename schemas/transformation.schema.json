{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/transformation.schema.json",
  "title": "Vajra Space Transformation",
  "type": "object",
  "additionalProperties": false,
  "required": ["transformation_id", "name", "input_refs", "output_ref", "method", "reproducibility"],
  "properties": {
    "transformation_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "output_ref": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "code_uri": {"type": ["string", "null"]},
    "code_hash": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "parameters": {"type": "object"},
    "reproducibility": {"type": "string", "enum": ["unknown", "partial", "reproducible", "reproduced"]}
  }
}
