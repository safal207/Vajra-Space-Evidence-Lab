{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/evidence.schema.json",
  "title": "Vajra Space Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "evidence_type", "source_uri", "source_hash", "collected_at", "uncertainty"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "evidence_type": {"type": "string", "enum": ["observation", "dataset", "publication", "code", "reproduction", "attestation"]},
    "source_uri": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "collected_at": {"type": "string", "format": "date-time"},
    "instrument_ref": {"type": ["string", "null"]},
    "transformation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]}
      }
    }
  }
}
