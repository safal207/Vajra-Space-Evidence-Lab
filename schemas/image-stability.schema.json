{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/image-stability.schema.json",
  "title": "Vajra Cross-Run Image Stability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "status",
    "claim_ref",
    "reference",
    "candidate",
    "comparators",
    "limitations"
  ],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["engineering_derived", "independently_reviewed"]},
    "claim_ref": {"type": "string", "minLength": 1},
    "reference": {"$ref": "#/$defs/run"},
    "candidate": {"$ref": "#/$defs/run"},
    "comparators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comparator_id", "metric_path", "operator", "threshold", "basis"],
        "properties": {
          "comparator_id": {"type": "string", "minLength": 1},
          "metric_path": {"type": "string", "minLength": 1},
          "operator": {"type": "string", "enum": ["max", "min"]},
          "threshold": {"type": "number"},
          "basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_run_id",
        "artifact_id",
        "artifact_digest",
        "fits_sha256",
        "oci_reference"
      ],
      "properties": {
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "integer", "minimum": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "fits_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "canonical_pixel_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "oci_reference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[a-fA-F0-9]{64}$"}
      }
    }
  }
}
