{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/reproduction.schema.json",
  "title": "Vajra Reproduction Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "version",
    "execution_mode",
    "working_directory",
    "timeout_seconds",
    "command",
    "expected_exit_code",
    "inputs",
    "outputs"
  ],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "execution_mode": {"type": "string", "enum": ["local", "container"]},
    "working_directory": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "expected_exit_code": {"type": "integer"},
    "environment": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[a-fA-F0-9]{64}$"
        },
        "user": {"type": "string", "default": "65534:65534"}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution_mode": {"const": "container"}},
        "required": ["execution_mode"]
      },
      "then": {"required": ["container"]},
      "else": {"not": {"required": ["container"]}}
    }
  ]
}
