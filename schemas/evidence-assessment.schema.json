{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/evidence-assessment.schema.json",
  "title": "Vajra Evidence-Level Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "version",
    "claim_ref",
    "provenance_complete",
    "observation_present",
    "data_available",
    "method_available",
    "code_available",
    "environment_pinned",
    "uncertainty_declared",
    "reproduced",
    "independent_confirmation",
    "multiple_independent_channels",
    "successful_falsifiable_predictions",
    "criterion_evidence",
    "limitations"
  ],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "claim_ref": {"type": "string", "minLength": 1},
    "provenance_complete": {"type": "boolean"},
    "observation_present": {"type": "boolean"},
    "data_available": {"type": "boolean"},
    "method_available": {"type": "boolean"},
    "code_available": {"type": "boolean"},
    "environment_pinned": {"type": "boolean"},
    "uncertainty_declared": {"type": "boolean"},
    "reproduced": {"type": "boolean"},
    "independent_confirmation": {"type": "boolean"},
    "multiple_independent_channels": {"type": "boolean"},
    "successful_falsifiable_predictions": {"type": "boolean"},
    "criterion_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "justification", "refs"],
        "properties": {
          "value": {"type": "boolean"},
          "justification": {"type": "string", "minLength": 1},
          "refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
