{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/falsification.schema.json",
  "title": "Vajra Falsification Criteria",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "falsification_id",
    "target_claim_ref",
    "status",
    "tests",
    "independence_requirements",
    "limitations"
  ],
  "properties": {
    "falsification_id": {"type": "string", "minLength": 1},
    "target_claim_ref": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["planned", "partially_evaluable", "evaluable", "evaluated"]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "question",
          "observable",
          "method",
          "required_input_refs",
          "missing_prerequisites",
          "support_condition",
          "refutation_condition",
          "inconclusive_condition",
          "evaluation_status",
          "result_evidence_refs"
        ],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "observable": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "required_input_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "missing_prerequisites": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "support_condition": {"type": "string", "minLength": 1},
          "refutation_condition": {"type": "string", "minLength": 1},
          "inconclusive_condition": {"type": "string", "minLength": 1},
          "evaluation_status": {
            "type": "string",
            "enum": [
              "not_evaluated",
              "pending_data",
              "inconclusive",
              "supports_target",
              "refutes_target"
            ]
          },
          "result_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "independence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
