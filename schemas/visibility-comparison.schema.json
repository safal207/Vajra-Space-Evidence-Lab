{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/visibility-comparison.schema.json",
  "title": "Vajra Visibility-Domain Comparison Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "status",
    "method",
    "image",
    "bands",
    "summary",
    "limitations"
  ],
  "properties": {
    "report_version": {"type": "integer", "const": 1},
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "failed"]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "library", "declared_version", "transform_type", "observables"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "library": {"type": "string", "const": "ehtim"},
        "declared_version": {"type": "string", "minLength": 1},
        "transform_type": {"type": "string", "minLength": 1},
        "observables": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "image": {"$ref": "#/$defs/fileIdentity"},
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["band_id", "uvfits", "row_count", "observables"],
        "properties": {
          "band_id": {"type": "string", "minLength": 1},
          "uvfits": {"$ref": "#/$defs/fileIdentity"},
          "row_count": {"type": "integer", "minimum": 1},
          "observables": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/observableResult"}
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_count", "successful_count", "failed_count"],
      "properties": {
        "requested_count": {"type": "integer", "minimum": 1},
        "successful_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "observableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable", "status", "reduced_chi_squared", "api_path", "issues"],
      "properties": {
        "observable": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["success", "unsupported", "error"]},
        "reduced_chi_squared": {"type": ["number", "null"], "minimum": 0},
        "api_path": {"type": ["string", "null"]},
        "issues": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
