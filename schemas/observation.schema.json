{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/observation.schema.json",
  "title": "Vajra Space Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "description", "observed_at", "instrument_ref", "source_hash", "uncertainty"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "instrument_ref": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "data_uri": {"type": ["string", "null"]},
    "band_or_channel": {"type": ["string", "null"]},
    "uncertainty": {"type": "object", "required": ["description"], "properties": {"description": {"type": "string", "minLength": 1}, "value": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]}}}
  }
}
