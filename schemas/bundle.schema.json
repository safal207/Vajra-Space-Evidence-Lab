{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-space.org/schemas/bundle.schema.json",
  "title": "Vajra Space Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "status", "objects", "root_claim_refs"],
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["incomplete", "complete", "superseded"]},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "path", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["claim", "evidence", "observation", "instrument", "transformation", "assumption", "falsification"]
          },
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "root_claim_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "missing": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}